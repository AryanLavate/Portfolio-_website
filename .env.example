# Copy this file to .env and fill in your values.
# Never commit .env to git!

# ── Resend (https://resend.com) ──────────────────────────────────────────────
# Create a free account, verify a domain (or use onboarding@resend.dev for testing),
# then create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "from" address shown in the OTP email.
# Must be a verified sender in your Resend account.
# For testing without a domain you can use: onboarding@resend.dev
MAIL_FROM=onboarding@resend.dev

# Your email — where contact form messages are delivered.
MAIL_TO=your@email.com

# ── Security ─────────────────────────────────────────────────────────────────
# Any long random string. Used to sign verification tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VERIFICATION_SECRET=replace-with-a-long-random-string

# ── CORS ─────────────────────────────────────────────────────────────────────
# The exact origin of your Vercel frontend (no trailing slash).
CORS_ORIGIN=https://portfolio-website-lilac-one.vercel.app

# ── Render / Proxy ────────────────────────────────────────────────────────────
# Set to 1 when running behind a reverse proxy (Render, Railway, etc.)
# so rate limiting uses the real client IP instead of the proxy IP.
TRUST_PROXY=1

# ── Port ─────────────────────────────────────────────────────────────────────
# Render sets this automatically. You can override locally.
# PORT=3000
