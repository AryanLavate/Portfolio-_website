# Dependencies
node_modules/

# Environment & secrets (never commit real credentials)
.env
.env.*
.env.local
.env.*.local
!.env.example
!**/.env.example
server/.env
client/.env
server/.env.*
client/.env.*

# Keys & credentials (common leak patterns)
*.pem
*.p12
*.pfx
id_rsa
id_rsa.pub
*.key
credentials.json
serviceAccount*.json
.secrets

# Logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Build / cache (regenerate with npm run build:contact)
client/dist
.vite
.cache
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/

# Optional local editor overrides (keep shared .vscode/ if you want)
.vscode/*.local.json

# Env backups people sometimes create by mistake
.env.backup
.env.bak
*.env.save
